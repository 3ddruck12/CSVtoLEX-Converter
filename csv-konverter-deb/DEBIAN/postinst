#!/bin/bash
# Post-Installationsskript für csv-konverter

# Erstelle Import/Export Ordner im Home-Verzeichnis des Benutzers
# (wird beim ersten Start der Anwendung erstellt, hier nur als Fallback)
# Die Anwendung erstellt die Ordner automatisch in ~/csvtolex/Import und ~/csvtolex/Export

# Aktualisiere Desktop-Datenbank
if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database -q 2>/dev/null || true
fi

exit 0

